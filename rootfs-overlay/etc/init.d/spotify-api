# TarsOS: Web API do Spotify (tocando agora + controle) para o player da tela.
name="Spotify Web API"
supervisor=supervise-daemon
command="/usr/local/bin/spotify-api"
respawn_delay=5
respawn_max=0
output_log="/var/log/spotify-api.log"
error_log="/var/log/spotify-api.log"
depend() {
	need net
	after networkmanager local
}
start_pre() {
	checkpath -d -m 0755 /run/luizinhoshowos
}
