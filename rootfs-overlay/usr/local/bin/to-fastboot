#!/bin/sh
# Reinicia no fastboot liberado gravando "FASTBOOT_PLEASE" na MISC (p8).
# A MISC não é crítica (não é lk/preloader/tee).
MISC=/dev/disk/by-partlabel/MISC
[ -e "$MISC" ] || MISC=/dev/mmcblk0p8
printf 'FASTBOOT_PLEASE\0' | dd of="$MISC" bs=16 count=1 conv=notrunc 2>/dev/null && sync && reboot
